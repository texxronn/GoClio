{
  "name": "measurements",
  "label": "Pool Measurements",
  "description": "Daily pool water measurements",
  "kind": "timeseries",
  "timestamp_field": "measured_at",
  "fields": [
    {
      "name": "measured_at",
      "label": "Measured at",
      "type": "datetime",
      "required": true
    },
    {
      "name": "ph",
      "label": "pH",
      "type": "decimal",
