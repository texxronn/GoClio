      "max": "14"
    },
    {
      "name": "free_chlorine",
      "label": "Free chlorine (ppm)",
      "type": "decimal",
      "min": "0"
    },
    {
      "name": "temperature_c",
      "label": "Temperature (°C)",
      "type": "decimal"
    }
  ]
}
